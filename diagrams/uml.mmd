classDiagram
    direction TB

    class Owner {
        +str owner_id
        +str name
        +int daily_minutes_available
        +list~str~ preferences
        +add_pet(pet Pet) Pet
        +get_pets() list~Pet~
        +get_all_tasks() list~Task~
        +pet_name_for(pet_id str) str
        +filter_tasks(pet_name, completed) list~Task~
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +str breed
        +int age_years
        +str owner_id
        +add_task(task Task) Task
        +list_tasks() list~Task~
        +mark_task_complete(task_id, reference_date) Task
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +int priority
        +time preferred_time
        +date due_date
        +bool completed
        +bool is_recurring
        +str recurrence_rule
        +mark_complete() None
        +create_next_occurrence(from_date) Task
        +is_due_on(plan_date) bool
    }

    class Scheduler {
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +detect_same_time_conflicts(tasks, owner) list~str~
        +detect_conflicts(plan) list~str~
        +next_available_slot(plan, minutes) time
        +schedule_day(owner, plan_date) DailyPlan
        +apply_time_budget(tasks, minutes) tuple
        +explain_plan(plan) list~str~
    }

    class DailyPlan {
        +date plan_date
        +str owner_id
        +list~ScheduledItem~ items
        +list~str~ notes
        +list~Task~ deferred_tasks
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : care_tasks
    Scheduler ..> Owner : get_all_tasks(), budget
    Scheduler ..> Task : sort, filter, schedule
    Scheduler ..> DailyPlan : produces
    DailyPlan "1" *-- "*" ScheduledItem : contains
    ScheduledItem --> Task : schedules
