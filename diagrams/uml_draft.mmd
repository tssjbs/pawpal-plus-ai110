classDiagram
    direction TB

    class Owner {
        +str owner_id
        +str name
        +int daily_minutes_available
        +list~str~ preferences
        +add_pet(pet Pet) Pet
        +get_pets() list~Pet~
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +str breed
        +int age_years
        +str owner_id
        +add_task(task Task) Task
        +list_tasks() list~Task~
    }

    class Task {
        +str task_id
        +str pet_id
        +str title
        +str category
        +int duration_minutes
        +int priority
        +bool is_recurring
        +str recurrence_rule
        +mark_complete() None
    }

    class Scheduler {
        +schedule_day(owner Owner, pet Pet, tasks list~Task~, date date) DailyPlan
        +sort_by_priority(tasks list~Task~) list~Task~
        +detect_conflicts(plan DailyPlan) list~str~
        +apply_time_budget(tasks list~Task~, minutes int) list~Task~
        +explain_plan(plan DailyPlan) list~str~
    }

    class DailyPlan {
        +date plan_date
        +str pet_id
        +list~ScheduledItem~ items
        +list~str~ notes
        +list~Task~ deferred_tasks
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : care_tasks
    Scheduler ..> Owner : reads constraints
    Scheduler ..> Pet : plans for
    Scheduler ..> Task : orders
    Scheduler ..> DailyPlan : produces
    DailyPlan "1" *-- "*" ScheduledItem : contains
