classDiagram
    direction TB

    class Owner {
        +str name
        +int daily_minutes_available
        +add_pet(pet Pet) Pet
        +get_pets() list~Pet~
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +add_task(task Task) Task
        +list_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +int priority
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +schedule_day(owner Owner, plan_date date) DailyPlan
        +sort_by_priority(tasks) list~Task~
        +detect_conflicts(plan) list~str~
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : care_tasks
    Scheduler ..> Owner : reads constraints
    Scheduler ..> DailyPlan : produces
